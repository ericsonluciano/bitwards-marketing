# Copy to .env.local to override. All values are public (they end up in the page's links), so nothing here is secret.
# This website's own address (used for the sitemap and page addresses):
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Where the "Get started" buttons go (the customer app):
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3300
# Where the "Apply" buttons go (the business app):
NEXT_PUBLIC_BUSINESS_URL=http://127.0.0.1:3100
# Optional. Shown in the footer when set. Leave empty until the mailbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional. Each one adds an icon to the footer when set. Use the full address of the public page, for example https://www.facebook.com/yourpage
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=
# Optional error tracking (Sentry project "bitwards-marketing"). Leave empty to switch it off completely.
# Set both in the Vercel project's environment variables; NEXT_PUBLIC_ one must be present at build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
